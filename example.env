# Kopieer dit bestand naar .env en vul het in. De .env komt niet in git.

# Waar de brug Tandoor kan vinden. Dit is het adres zoals de NAS het ziet.
TANDOOR_URL=http://192.168.1.130:30290

# Het API-token uit Tandoor: Instellingen → API → nieuw token, scope
# "read write". Het begint met tda_ en is maar vijftien seconden lang
# leesbaar, dus kopieer het meteen.
TANDOOR_TOKEN=tda_vul_hier_je_eigen_token_in

# Het adres waar de links in de interface naartoe wijzen. Handig als je de
# brug onderweg via Tailscale gebruikt: dan werken de links naar Tandoor ook.
# Laat leeg om TANDOOR_URL te gebruiken.
TANDOOR_PUBLIC_URL=http://tail2bbdeb.ts.net:30290

# De poort waarop de brug luistert.
PORT=8095

# Pauze tussen twee imports. De importroute van Tandoor is standaard
# afgeknepen op 60 per uur; zie de README bij "de limiet van 60 per uur".
IMPORT_DELAY_SECONDS=5

# Waar de SQLite-database komt. Binnen de container is dit het volume.
DATA_DIR=/data

# Voedingswaarden meesturen bij het aanmaken. Standaard uit: Tandoor schrijft
# daarbij de naam uit het verzoek op het bestaande PropertyType in je ruimte,
# en daar blijft de brug liever van af.
SEND_PROPERTIES=false

# De Albert Heijn-route: het recept bij api.ah.nl ophalen in plaats van bij de
# pagina, die Akamai tegenhoudt. Zie de README bij "Albert Heijn: de app-API".
# Zet op 0 als AH die API ooit dichtzet; dan blijft voor AH alleen de
# bookmarklet over (de browser-container krijgt bij www.ah.nl ook een 403).
AH_API=1

# De API wil de officiële app zien. Weigert AH ons, kijk dan eerst welke
# versie er nu in de App Store staat en zet die hier - dat kan zonder nieuwe
# image.
# AH_CLIENT_ID=appie-ios
# AH_CLIENT_VERSION=9.28
# AH_USER_AGENT=

# Ingrediënten bij de juiste stap, met Tandoors eigen AI-sortering. Zie de
# README bij "Ingrediënten bij de juiste stap (AI)".
#
# Welke AI-provider uit Tandoor (Instellingen → AI). Leeg laten: de
# standaardprovider van je space, of de enige die er is. Het tabblad Sorteren
# laat zien welke er gebruikt wordt, en welke ids er zijn.
TANDOOR_AI_PROVIDER_ID=
# Nieuwe recepten bij het importeren meteen laten sorteren.
AI_SORT_IMPORTS=1
# Hetzelfde als AI_RATELIMIT in je Tandoor (standaard 60/hour). De
# sorteerronde wacht daardoor een minuut tussen twee AI-vragen. Let op: in
# Tandoor telt elke import ook mee voor deze limiet.
AI_RATELIMIT=60/hour

# Waar de brug de browser-container vindt, voor sites die hun recept pas met
# JavaScript opbouwen. Deze hoort bij de brug. De naam is die van de service
# in docker-compose.yml; laat hem leeg als je die service niet draait.
RENDERER_URL=http://tandoor-bridge-renderer:8096

# Alleen voor de browser-container (zet deze bij die service, niet bij de
# brug). BROWSER_CHANNEL=chromium gebruikt het volledige binary in plaats van
# Playwrights kalere "headless shell", die makkelijker te herkennen is.
# BROWSER_CHANNEL=chromium
# USER_AGENT=
# BROWSER_IDLE_SECONDS=120

# INFO is genoeg; DEBUG als je wilt zien wat er precies over de lijn gaat.
LOG_LEVEL=INFO
